<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>remroc_ha</name>
  <version>0.1.0</version>
  <description>Human-aware, uncertainty-robust MAPF for REMROC: human motion prediction, risk-aware CBS client, Action Dependency Graph execution with local repair, metrics, and a ROS-free grid-level simulator.</description>
  <maintainer email="Masimba249@gmail.com">Collins Masimba</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
